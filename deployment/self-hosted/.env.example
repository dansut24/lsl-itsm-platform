# Hi5Central self-hosted reference configuration
# Copy to .env and replace every CHANGE_ME value before starting.

# Public hostname ------------------------------------------------------------
APP_HOST=itsm.hi5tech.co.uk
ACME_EMAIL=CHANGE_ME@example.com

# Deployment / tenancy -------------------------------------------------------
DEPLOYMENT_MODE=self_hosted
TENANCY_MODE=single
ROOT_DOMAIN=itsm.hi5tech.co.uk
PRIMARY_TENANT_SLUG=hi5tech

APP_URL=https://itsm.hi5tech.co.uk
API_URL=https://itsm.hi5tech.co.uk
PORTAL_URL=https://itsm.hi5tech.co.uk/portal
RMM_URL=https://itsm.hi5tech.co.uk/rmm
MARKETING_URL=https://itsm.hi5tech.co.uk
DOWNLOADS_URL=https://itsm.hi5tech.co.uk/downloads
TURN_URL=
COOKIE_DOMAIN=

# Database / cache -----------------------------------------------------------
POSTGRES_DB=hi5central
POSTGRES_USER=hi5central
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
REDIS_PASSWORD=CHANGE_ME_LONG_RANDOM_REDIS_PASSWORD

# Initial self-host evaluation ----------------------------------------------
SELF_HOST_EVALUATION_PRODUCTS=itsm,rmm
SELF_HOST_EVALUATION_USER_LIMIT=25
SELF_HOST_EVALUATION_DEVICE_LIMIT=100

# Email ----------------------------------------------------------------------
# Required before email verification / password reset can be exercised.
SMTP_HOST=smtp.ionos.co.uk
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=CHANGE_ME

# Microsoft 365 / Entra ID / Intune ------------------------------------------
# Register a confidential Web application in Microsoft Entra ID.
# Redirect URI: ${API_URL}/api/v1/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=

# API ------------------------------------------------------------------------
NODE_ENV=production
