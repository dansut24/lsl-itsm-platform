:80 {
  encode zstd gzip

  handle /api/* {
    reverse_proxy api:3001
  }

  handle /healthz {
    respond "ok" 200
  }

  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }

  header {
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "SAMEORIGIN"
    -Server
  }
}
